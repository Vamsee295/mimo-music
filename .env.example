# Optional: YouTube Data API v3 key so every user gets full songs without entering their own.
# Get one free at https://console.cloud.google.com (enable "YouTube Data API v3"). Copy to .env.local.
NEXT_PUBLIC_YT_KEY=

# Listen Together (party mode): your Supabase project's URL and its publishable key (or the older "anon" key as NEXT_PUBLIC_SUPABASE_ANON_KEY)
# (Supabase dashboard → Project Settings → API). Only Realtime broadcast + presence are used: no tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
